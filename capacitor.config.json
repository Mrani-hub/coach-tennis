{
  "appId": "ma.coachtennis.app",
  "appName": "Coach Tennis",
  "webDir": "www",
  "backgroundColor": "#1d5c45",
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#1d5c45",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_uscm",
      "iconColor": "#1d5c45"
    },
    "SocialLogin": {
      "logLevel": 1
    },
    "BackgroundRunner": {
      "label": "ma.coachtennis.app.verification",
      "src": "runners/programme.js",
      "event": "verifierProgramme",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
